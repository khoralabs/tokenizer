{
  "name": "@khoralabs/tkn",
  "version": "0.0.0",
  "private": true,
  "description": "Fast greedy pattern discovery and lattice-backed tokenizer for sequential data.",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/tokenizer.git"
  },
  "homepage": "https://github.com/khoralabs/tokenizer#readme",
  "bugs": "https://github.com/khoralabs/tokenizer/issues",
  "keywords": [
    "tokenizer",
    "lz",
    "pattern-discovery",
    "sequential-data",
    "bun"
  ],
  "bin": {
    "tkn": "./scripts/tkn.ts",
    "tokenize": "./scripts/tokenize.ts"
  },
  "files": [
    "src",
    "scripts/tkn.ts",
    "scripts/tokenize.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./bun-sqlite": {
      "bun": "./src/bun-sqlite.ts",
      "node": "./src/bun-sqlite.ts",
      "types": "./src/bun-sqlite.ts"
    },
    "./turso": {
      "bun": "./src/turso.ts",
      "node": "./src/turso.ts",
      "types": "./src/turso.ts"
    },
    "./memory": {
      "bun": "./src/memory.ts",
      "node": "./src/memory.ts",
      "types": "./src/memory.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "biome": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky",
    "stage-release": "bun run scripts/stage-release.ts",
    "agent-review": "agent-review",
    "review": "agent-review run --scope staged --include-workstream",
    "context": "bun run scripts/context.ts",
    "tkn": "bun scripts/tkn.ts",
    "tokenize": "bun scripts/tokenize.ts"
  },
  "dependencies": {
    "@tursodatabase/database": "^0.6.1",
    "typebox": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@khoralabs/agent-review": "0.2.0",
    "@types/bun": "latest",
    "@types/parse-gitignore": "^1.0.2",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
